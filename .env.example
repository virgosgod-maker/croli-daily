# ===== 凭据 =====
# 与桌面端 auth.json 同格式。必须只有本程序在写（refresh token 一次性）
CROLI_AUTH_FILE=~/.config/croli-daily/auth.json
CROLI_STATE_DIR=~/.local/state/croli-daily

# ===== Clerk OAuth（Croli 官方客户端参数，从 app.asar 提取）=====
CROLI_CLERK_CLIENT_ID=znV4SkcUsY1AektQ
CROLI_CLERK_TOKEN_URL=https://clerk.croli.net/oauth/token
CROLI_CREDITS_BASE=https://ds.croli.net/credits

# ===== 每日首次对话 =====
# off  只签到（默认，最安全）
# real 用 croli-cli 真跑一次对话；需要 CROLI_CLI 指向可执行文件 + 可用 agent
DAILY_CHAT_MODE=off
CROLI_CLI=/Applications/Croli.app/Contents/Resources/bin/arm64/croli-cli
DAILY_CHAT_PROMPT=早，今天也一切顺利吗？一句话就好。

# ===== 常驻调度（serve 模式）=====
RUN_AT_HOUR=0
RUN_AT_MINUTE=10

# ===== 网页面板 =====
DASHBOARD_PORT=8787
DASHBOARD_HOST=0.0.0.0
# 设了就要求 ?token=xxx
# DASHBOARD_TOKEN=
